{
  "storybook": {
    "url": "http://localhost:6006",
    "staticDir": "storybook-static"
  },
  "extract": {
    "properties": [
      "color", "backgroundColor", "borderColor",
      "fontSize", "fontWeight", "fontFamily", "lineHeight", "letterSpacing",
      "borderRadius", "borderWidth", "boxShadow", "zIndex",
      "padding", "margin", "gap"
    ],
    "ignoreValues": [
      "rgba(0, 0, 0, 0)", "transparent", "none", "normal", "auto",
      "0px", "rgb(0, 0, 0)"
    ],
    "perStoryTimeoutMs": 8000,
    "gapCollapse": { "enabled": true, "maxOverlapPx": 0 }
  },
  "clustering": {
    "colorDistance": 24,
    "colorAlphaTolerance": 0.05,
    "spacingTolerancePx": 2,
    "fontSizeTolerancePx": 1,
    "driftMaxUsage": 2,
    "driftMaxUsageRatio": 0.15
  },
  "grid": {
    "scale": [2, 4, 8, 16, 32, 64, 128, 256, 512],
    "tolerancePx": 2,
    "properties": ["padding", "margin", "gap", "borderRadius", "borderWidth"]
  },
  "output": { "dir": "design-audit" }
}
